{
  "schema_version": 1,
  "project_id": "select-ai-analyzer",
  "terraform": {
    "path": "terraform",
    "package_oci_credentials": true
  },
  "capabilities": {
    "compartment_modes": [
      "new",
      "existing"
    ],
    "requires_genai_region": true,
    "database_profile": "new_or_existing"
  },
  "form": {
    "email_access_fields": [
      "application_username",
      "autonomous_database_developer_password"
    ],
    "fields": [
      {
        "name": "autonomous_database_mode",
        "label": "Database mode",
        "type": "select",
        "required": true,
        "default": "new",
        "group": "database",
        "options": [
          {
            "value": "new",
            "label": "Create new database"
          },
          {
            "value": "existing",
            "label": "Use existing database"
          }
        ]
      },
      {
        "name": "existing_autonomous_database_ocid",
        "label": "Existing database OCID",
        "type": "text",
        "required": true,
        "group": "database",
        "visible_when": {
          "field": "autonomous_database_mode",
          "equals": "existing"
        }
      },
      {
        "name": "autonomous_database_version",
        "label": "Database profile",
        "type": "select",
        "required": true,
        "default": "26ai:DW",
        "transform": "database_profile",
        "group": "database",
        "visible_when": {
          "field": "autonomous_database_mode",
          "equals": "new"
        },
        "span": 2,
        "options": [
          {
            "value": "26ai:DW",
            "label": "Oracle AI Database 26ai — Data Warehouse"
          },
          {
            "value": "26ai:OLTP",
            "label": "Oracle AI Database 26ai — Transaction Processing"
          },
          {
            "value": "19c:DW",
            "label": "Oracle Database 19c — Data Warehouse"
          },
          {
            "value": "19c:OLTP",
            "label": "Oracle Database 19c — Transaction Processing"
          }
        ]
      },
      {
        "name": "autonomous_database_admin_password",
        "label": "Database ADMIN password",
        "type": "password",
        "required": true,
        "secret": true,
        "group": "database"
      },
      {
        "name": "autonomous_database_wallet_password",
        "label": "Database wallet password",
        "type": "password",
        "required": true,
        "secret": true,
        "group": "database"
      },
      {
        "name": "application_username",
        "label": "Application username",
        "type": "text",
        "required": true,
        "default": "admin",
        "group": "application_vm"
      },
      {
        "name": "autonomous_database_developer_password",
        "label": "Application password",
        "type": "password",
        "required": true,
        "secret": true,
        "group": "application_vm"
      },
      {
        "name": "select_ai_grant_schemas",
        "label": "Schemas exposed to Select AI",
        "type": "select",
        "required": true,
        "default": "SH_DEMO,FLEXCUBE_DEMO",
        "multiple": true,
        "group": "application_vm",
        "visible_when": {
          "field": "autonomous_database_mode",
          "equals": "new"
        },
        "span": 1,
        "options": [
          {
            "value": "SH_DEMO",
            "label": "Sales History (SH_DEMO)"
          },
          {
            "value": "FLEXCUBE_DEMO",
            "label": "Core Banking (FLEXCUBE_DEMO)"
          }
        ]
      }
    ]
  },
  "presentation": {
    "title": "Select AI Analyzer",
    "summary": "Deploys a Select AI workspace for governed natural-language questions over relational data and uploaded CSV sources.",
    "tags": ["Autonomous AI Database", "Generative AI", "Select AI", "Compute VM"],
    "image": "/assets/select-ai-analyzer.png",
    "image_alt": "Select AI Analyzer application preview",
    "href": "https://github.com/jgangini/select-ai-analyzer"
  },
  "run_steps": [
    {"key": "queue", "label": "Queue"},
    {"key": "credentials", "label": "OCI credentials"},
    {"key": "compartment", "label": "Compartment"},
    {"key": "policies", "label": "IAM policies"},
    {"key": "stack", "label": "Resource Manager stack"},
    {"key": "plan", "label": "Terraform plan"},
    {"key": "apply", "label": "Terraform apply"},
    {"key": "network", "label": "Network and VCN"},
    {"key": "bucket", "label": "Object Storage"},
    {"key": "compute", "label": "Application VM"},
    {"key": "database", "label": "Autonomous Database"},
    {"key": "wallet", "label": "Database wallet"},
    {"key": "application", "label": "Application setup"},
    {"key": "artifacts", "label": "Access artifacts"},
    {"key": "email", "label": "Access email"},
    {"key": "complete", "label": "Ready"}
  ],
  "outputs": [
    "application_url",
    "ssh_user",
    "adb_db_name",
    "autonomous_database_id",
    "bucket_name"
  ],
  "artifacts": [
    "adb_wallet.zip",
    "ssh-private-key.pem",
    "connection-summary.txt"
  ],
  "post_apply": null
}
