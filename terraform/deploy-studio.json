{
  "schema_version": 1,
  "project_id": "select-ai-analyzer",
  "terraform": {
    "path": "terraform",
    "package_oci_credentials": true
  },
  "capabilities": {
    "compartment_modes": [
      "new",
      "existing"
    ],
    "requires_genai_region": true,
    "database_profile": "new_or_existing"
  },
  "form": {
    "fields": [
      {
        "name": "autonomous_database_mode",
        "label": "Database mode",
        "type": "select",
        "required": true,
        "default": "new",
        "options": [
          {
            "value": "new",
            "label": "Create new database"
          },
          {
            "value": "existing",
            "label": "Use existing database"
          }
        ]
      },
      {
        "name": "existing_autonomous_database_ocid",
        "label": "Existing database OCID",
        "type": "text",
        "required": true,
        "visible_when": {
          "field": "autonomous_database_mode",
          "equals": "existing"
        }
      },
      {
        "name": "autonomous_database_version",
        "label": "Database profile",
        "type": "select",
        "required": true,
        "default": "26ai:DW",
        "transform": "database_profile",
        "visible_when": {
          "field": "autonomous_database_mode",
          "equals": "new"
        },
        "span": 2,
        "options": [
          {
            "value": "26ai:DW",
            "label": "Oracle AI Database 26ai â€” Data Warehouse"
          },
          {
            "value": "26ai:OLTP",
            "label": "Oracle AI Database 26ai â€” Transaction Processing"
          },
          {
            "value": "19c:DW",
            "label": "Oracle Database 19c â€” Data Warehouse"
          },
          {
            "value": "19c:OLTP",
            "label": "Oracle Database 19c â€” Transaction Processing"
          }
        ]
      },
      {
        "name": "autonomous_database_admin_password",
        "label": "Database ADMIN password",
        "type": "password",
        "required": true,
        "secret": true
      },
      {
        "name": "autonomous_database_wallet_password",
        "label": "Database wallet password",
        "type": "password",
        "required": true,
        "secret": true
      },
      {
        "name": "application_username",
        "label": "Application username",
        "type": "text",
        "required": true,
        "default": "admin"
      },
      {
        "name": "autonomous_database_developer_password",
        "label": "Application password",
        "type": "password",
        "required": true,
        "secret": true
      }
    ]
  },
  "outputs": [
    "application_url",
    "ssh_user",
    "adb_db_name",
    "autonomous_database_id",
    "bucket_name"
  ],
  "artifacts": [
    "adb_wallet.zip",
    "ssh-private-key.pem",
    "connection-summary.txt"
  ],
  "post_apply": null
}
