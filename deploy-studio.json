{
  "schema_version": 1,
  "project_id": "select-ai-analyzer",
  "terraform": {
    "path": "infra/terraform",
    "package_oci_credentials": true
  },
  "capabilities": {
    "compartment_modes": [
      "new",
      "existing"
    ],
    "requires_genai_region": true,
    "database_profile": "new_or_existing"
  },
  "form": {
    "fields": [
      {
        "name": "autonomous_database_mode",
        "label": "Autonomous Database mode",
        "type": "select",
        "required": true,
        "default": "new",
        "options": [
          {
            "value": "new",
            "label": "Create new database"
          },
          {
            "value": "existing",
            "label": "Use existing database"
          }
        ]
      },
      {
        "name": "existing_autonomous_database_ocid",
        "label": "Existing Autonomous Database OCID",
        "type": "text",
        "required": false
      },
      {
        "name": "autonomous_database_version",
        "label": "Autonomous Database version",
        "type": "select",
        "required": true,
        "default": "26ai",
        "options": [
          {
            "value": "26ai",
            "label": "Oracle AI Database 26ai"
          },
          {
            "value": "19c",
            "label": "Oracle Database 19c"
          }
        ]
      },
      {
        "name": "autonomous_database_workload",
        "label": "Autonomous Database workload",
        "type": "select",
        "required": true,
        "default": "DW",
        "options": [
          {
            "value": "DW",
            "label": "Data Warehouse"
          },
          {
            "value": "OLTP",
            "label": "Transaction Processing"
          }
        ]
      },
      {
        "name": "autonomous_database_admin_password",
        "label": "Autonomous Database ADMIN password",
        "type": "password",
        "required": true,
        "secret": true
      },
      {
        "name": "autonomous_database_wallet_password",
        "label": "Autonomous Database wallet password",
        "type": "password",
        "required": true,
        "secret": true
      },
      {
        "name": "autonomous_database_developer_password",
        "label": "Select AI Analyzer password",
        "type": "password",
        "required": true,
        "secret": true
      },
      {
        "name": "application_username",
        "label": "Application username",
        "type": "text",
        "required": true,
        "default": "admin"
      }
    ]
  },
  "outputs": [
    "application_url",
    "ssh_user",
    "adb_db_name",
    "autonomous_database_id",
    "bucket_name"
  ],
  "artifacts": [
    "adb_wallet.zip",
    "ssh-private-key.pem",
    "connection-summary.txt"
  ],
  "post_apply": null
}
